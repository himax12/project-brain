# CockroachDB (required for Phase 1)
DATABASE_URL=postgresql://user:password@host:26257/defaultdb?sslmode=verify-full

# API auth (Phase 2)
API_KEY=dev-local-key-change-me

# Defaults for demos
DEFAULT_ORG_ID=acme
DEFAULT_REPO_ID=billing

# Embeddings: 1 = skip Bedrock (Phase 1 OK)
EMBED_STUB=1
EMBED_DIM=1024

# AWS / Bedrock (Phase 4)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_CHAT_MODEL=anthropic.claude-3-haiku-20240307-v1:0
