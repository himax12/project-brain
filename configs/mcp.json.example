{
  "mcpServers": {
    "project-brain": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "C:/Users/ghima/Desktop/project-brain/apps/api",
        "python",
        "-m",
        "project_brain.mcp.server"
      ]
    },
    "cockroachdb-cloud": {
      "url": "https://cockroachlabs.cloud/mcp",
      "headers": {
        "mcp-cluster-id": "YOUR_CLUSTER_UUID"
      }
    }
  }
}
